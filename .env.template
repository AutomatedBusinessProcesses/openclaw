# OpenClaw Environment Variables (template — do not commit real keys)
OPENCLAW_CONFIG_DIR=$HOME/.openclaw
OPENCLAW_WORKSPACE_DIR=$HOME/.openclaw/workspace
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_EXTRA_MOUNTS=$HOME/OpenClaw-Workspace:/home/node/workspace:rw
OPENCLAW_HOME_VOLUME=openclaw_home
OPENCLAW_DOCKER_APT_PACKAGES=
OPENCLAW_SANDBOX=1
OPENCLAW_DOCKER_SOCKET=/var/run/docker.sock
DOCKER_GID=991
OPENCLAW_INSTALL_DOCKER_CLI=1
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
